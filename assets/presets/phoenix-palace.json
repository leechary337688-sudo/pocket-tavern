        "enabled": true
      },
      {
        "uid": 3,
        "key": [
          "女史官",
          "起居注"
        ],
        "keysecondary": [],
        "comment": "常识·女史官",
        "content": "女史官负责记录皇帝言行与朝会纪要，品阶不高，却能出入许多外臣进不去的地方。沈知微顶替亡兄沈知远的名额入朝，玉牌上的名字仍是“沈知远”。",
        "position": "before",
        "order": 20,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 4,
        "key": [
          "听雨楼"
        ],
        "keysecondary": [],
        "comment": "常识·听雨楼",
        "content": "听雨楼是京城最贵的茶楼，也是消息最灵的地方。楼主谢琅体弱，常年住在顶层，靠一根细线听楼下每一桌的动静。",
        "position": "before",
        "order": 30,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 5,
        "key": [
          "边关",
          "北境"
        ],
        "keysecondary": [],
        "comment": "常识·边关",
        "content": "北境三年无大战，裴燃却在一场小规模冲突里“战死”。朝廷追封的诏书还没发完，边关就传来他可能还活着的密报。",
        "position": "before",
        "order": 40,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 6,
        "key": [
          "教坊司",
          "柳如烟"
        ],
        "keysecondary": [],
        "comment": "常识·教坊司",
        "content": "教坊司掌宫廷乐舞，也替贵人传一些不能写在纸上的话。主事柳如烟消息灵通，最爱看年轻官员脸红。",
        "position": "before",
        "order": 50,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 7,
        "key": [
          "沈家",
          "灭门"
        ],
        "keysecondary": [],
        "comment": "真相·沈家灭门",
        "content": "十年前沈家被抄，罪名是私通敌国。真正的原因是沈父查到了温衡替先帝处理的一笔军饷旧账。沈知远替妹妹引开追兵后失踪，沈知微一直以为他死了。",
        "position": "before",
        "order": 100,
        "tokenBudget": 0,
        "recursive": false,
        "selective": true,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 8,
        "key": [
          "温衡",
          "首辅"
        ],
        "keysecondary": [],
        "comment": "真相·温衡真凶",
        "content": "温衡是沈家灭门案的主谋。他表面是清流领袖，实际掌控着军饷与盐引两条暗线。他收沈知微为门生，是因为怀疑“沈知远”没死。",
        "position": "before",
        "order": 110,
        "tokenBudget": 0,
        "recursive": false,
        "selective": true,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 9,
        "key": [
          "萧决",
          "摄政王"
        ],
        "keysecondary": [],
        "comment": "真相·摄政王保皇",
        "content": "萧决不是篡位者。他答应先帝保幼帝到亲政，朝堂上那些“摄政王要反”的传言，一半是温衡放的。",
        "position": "before",
        "order": 120,
        "tokenBudget": 0,
        "recursive": false,
        "selective": true,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 10,
        "key": [
          "裴燃",
          "假死"
        ],
        "keysecondary": [],
        "comment": "真相·裴燃假死",
        "content": "裴燃的“战死”是他与萧决做的局，为的是让温衡放松边关布防。他回京后不能公开露面，只能夜里翻墙。",
        "position": "before",
        "order": 130,
        "tokenBudget": 0,
        "recursive": false,
        "selective": true,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 11,
        "key": [
          "谢琅",
          "听雨楼"
        ],
        "keysecondary": [],
        "comment": "真相·谢琅的黑",
        "content": "谢琅替温衡做过事，也替萧决递过消息。他没有害沈知微，但他知道沈知远的下落，并且一直没说。",
        "position": "before",
        "order": 140,
        "tokenBudget": 0,
        "recursive": false,
        "selective": true,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 12,
        "key": [
          "赫连昭",
          "质子"
        ],
        "keysecondary": [],
        "comment": "真相·质子的局",
        "content": "赫连昭归国不是逃跑，是温衡与他母族做的交易。他若留在京城，反而会成为温衡的人质；他回去，是要从外部截断温衡的兵。",
        "position": "before",
        "order": 150,
        "tokenBudget": 0,
        "recursive": false,
        "selective": true,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 13,
        "key": [
          "沈知远",
          "亡兄"
        ],
        "keysecondary": [],
        "comment": "真相·亡兄下落",
        "content": "沈知远没有死。他被谢琅藏在听雨楼地窖，伤好后失去了一只手的力气，一直在替沈知微整理沈家旧案。他不出面，是因为“沈知远”活着会让顶替入朝的事立刻败露。",
        "position": "before",
        "order": 160,
        "tokenBudget": 0,
        "recursive": false,
        "selective": true,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 14,
        "key": [
          "第一幕",
          "入朝"
        ],
        "keysecondary": [],
        "comment": "节拍·第一幕 入朝",
        "content": "第一幕：沈知微以兄长身份入朝，第一次朝会就撞上温衡试探。萧决注意到她握笔的姿势不像男人。目标：先站稳，不暴露。",
        "position": "before",
        "order": 200,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 15,
        "key": [
          "第二幕",
          "夜宴"
        ],
        "keysecondary": [],
        "comment": "节拍·第二幕 夜宴",
        "content": "第二幕：宫中夜宴，丽贵妃试探沈知微，赫连昭以质子身份出席。谢琅在听雨楼递出第一张纸条。",
        "position": "before",
        "order": 210,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 16,
        "key": [
          "第三幕",
          "边关"
        ],
        "keysecondary": [],
        "comment": "节拍·第三幕 边关急报",
        "content": "第三幕：边关急报传来，裴燃“死而复生”的消息压不住。温衡借机逼萧决交出兵权；沈知微必须在朝会上替萧决找到退路。",
        "position": "before",
        "order": 220,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 17,
        "key": [
          "第四幕",
          "听雨楼"
        ],
        "keysecondary": [],
        "comment": "节拍·第四幕 听雨楼",
        "content": "第四幕：沈知微在听雨楼见到沈知远，知道谢琅一直瞒着她。她可以选择公开兄长还活着，或继续顶着名字查完旧案。",
        "position": "before",
        "order": 230,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 18,
        "key": [
          "第五幕",
          "大朝会"
        ],
        "keysecondary": [],
        "comment": "节拍·第五幕 大朝会",
        "content": "第五幕：大朝会摊牌。温衡拿出“沈知远已死”的证据，萧决与裴燃同时发难；沈知微要决定是恢复女儿身、继续做女史官，还是带着沈家离开京城。",
        "position": "before",
        "order": 240,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
