        "key": [
          "旧海关",
          "海关"
        ],
        "keysecondary": [],
        "comment": "常识·旧海关",
        "content": "旧海关二十年前因走私案关闭，如今只剩一排空仓库。夜里偶有灯火，官方记录却写着无人值守。",
        "position": "before",
        "order": 30,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
