        "key": [
          "花市",
          "温栀的花店"
        ],
        "keysecondary": [],
        "comment": "常识·花市",
        "content": "花市在旧海关背面，温栀的花店叫“晚香”。她每天清晨把白菊与湿漉漉的栀子摆到门口，像在等一个不会准时来的人。",
        "position": "before",
        "order": 40,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
