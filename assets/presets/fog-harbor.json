        "key": [
          "灯会",
          "河灯"
        ],
        "keysecondary": [],
        "comment": "常识·灯会",
        "content": "雾港每年雨季末尾办灯会，把写着名字的河灯放进江里。旧俗说，灯漂得越远，失踪的人越容易找到回家的路。",
        "position": "before",
        "order": 50,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
