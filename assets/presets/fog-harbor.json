        "enabled": true
      },
      {
        "uid": 2,
        "key": [
          "雾港",
          "临江府"
        ],
        "keysecondary": [],
        "comment": "常识·雾港",
        "content": "雾港是临江入海口的一座旧商埠，常年落雨，石板路被潮气浸得发黑。旧海关、花市、船坞和春灯舫分布在三条主街之间，外地人一进城就会闻到咸腥的雨味。",
        "position": "before",
        "order": 10,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
        "uid": 3,
        "key": [
          "春灯舫",
          "画舫"
        ],
        "keysecondary": [],
        "comment": "常识·春灯舫",
        "content": "春灯舫是雾港最大的画舫，入夜后沿江缓行。明面上是听曲吃酒的地方，暗舱里却常有人谈不记在账上的生意。舫主温栀定下规矩：船上不许拔刀，不许追问客人来处。",
        "position": "before",
        "order": 20,
        "tokenBudget": 0,
        "recursive": false,
        "selective": false,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
