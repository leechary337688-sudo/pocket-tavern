      {
        "uid": 9,
        "key": [
          "沈青禾",
          "姐姐",
          "失踪案"
        ],
        "keysecondary": [
          "沈知微",
          "查案"
        ],
        "comment": "真相·姐姐失踪",
        "content": "沈青禾没有死。她查到慈善船王沈鹤鸣利用旧海关走私，被追杀的当晚躲进了春灯舫的暗舱。她故意让妹妹看到“溺水”的假象，是为了让追查者收手。",
        "position": "before",
        "order": 100,
        "tokenBudget": 0,
        "recursive": false,
        "selective": true,
        "constant": false,
        "probability": 100,
        "caseSensitive": false,
        "useRegex": false,
        "enabled": true
      },
      {
