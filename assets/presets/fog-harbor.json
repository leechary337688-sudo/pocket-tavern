            "key": [
              "沈鹤鸣",
              "义父"
            ],
            "keysecondary": [],
            "comment": "温栀的义父",
            "content": "温栀父母早亡，十二岁被沈鹤鸣收养。她叫了他十六年义父，也替他挡过三次盘问。她真正想做的，是把他的船队送进法庭。",
            "position": "before",
            "order": 10,
            "tokenBudget": 0,
            "recursive": false,
            "selective": false,
            "constant": false,
            "probability": 100,
            "caseSensitive": false,
